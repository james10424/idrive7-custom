{
  "id": "live2d-render",
  "kind": "tool",
  "version": "0.1.2",
  "license": "MIT",
  "title": "Live2D Render",
  "description": "Draws a Live2D model live on the head unit's GPU for an app, shown as a cluster-render video layer. Needs Live2D's Cubism SDK copied to the head unit by hand",
  "mguHmi": [
    "ID7"
  ],
  "requires": {
    "mgu-deploy": "0.4.0"
  },
  "uninstallable": true,
  "files": [
    {
      "path": "live2d-render",
      "from": "prebuilt/live2d-render",
      "mode": "0755"
    }
  ],
  "units": [
    {
      "name": "live2d-render.socket",
      "from": "systemd/live2d-render.socket"
    },
    {
      "name": "live2d-render.service",
      "from": "systemd/live2d-render.service"
    }
  ],
  "enable": [
    {
      "unit": "live2d-render.socket",
      "target": "sockets.target"
    }
  ],
  "restart": [
    "live2d-render.service"
  ]
}
