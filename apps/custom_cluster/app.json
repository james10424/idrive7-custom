{
  "id": "custom_cluster",
  "title": "Custom Cluster",
  "description": "Redraws the instrument cluster: a 1987 Regal dash, or a Sport view round BMW's map while navigating",
  "version": "0.1.37",
  "vendor": "custom",
  "loggingId": "OCC1",
  "iconGlyph": "CLU",
  "shared": [
    "hud.js",
    "hud_text.js",
    "hud_data.js",
    "hud_themes.js",
    "layouts.js",
    "shaders.js",
    "icons.js",
    "shift_score.js",
    "sun.js",
    "cluster_render_client.js",
    "calibration.js",
    "visible.js",
    "sysfont.js",
    "opentype.js"
  ],
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs",
      "statusBattery2": "rs",
      "statusHandBrake": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusLateralAccelerationMassCenter": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs",
      "statusStandstillFunctions": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusSwitchDriveDynamicSport2": "rs",
      "statusActualValueTorque2": "rs",
      "statusFESVehicleDynamicSwitchHMI": "rs",
      "statusVehicleDynamicEngine": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.KombiIF": {
      "statusRangeTankStatus": "rs",
      "statusShowTimeDate": "rs"
    },
    "de.bmw.infotainment.navigation.guiding.Guidance": {
      "_instances": "Main_Instance",
      "guidanceState": "rs",
      "_optional": "route guidance on / off (the \"While navigating\" theme) and the route's progress (Sport's route bar)",
      "finalDestinationInfo": "rs",
      "travelledDistance": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "statusNewCurrentUnitsStatusExt": "rs",
      "_optional": "the car's pressure and temperature units, for the tyre block"
    },
    "de.bmw.infotainment.misc.MDrive": {
      "dataDisplayGearbox": "s",
      "_optional": "S or M next to the gear"
    },
    "de.bmw.infotainment.vehicle.TPMS": {
      "statusTyrePressure": "rs",
      "statusTyreTemperature": "rs",
      "_optional": "tyre pressures and temperatures in the M theme"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s"
    },
    "de.bmw.dass.GapVehicleAhead": {
      "DataFrontVehicle": "s",
      "GapVehicleDrivingAhead": "s"
    },
    "de.bmw.powertrain.AcceleratorPedal": {
      "AngleAcceleratorPedal": "s"
    },
    "de.bmw.body.Light": {
      "LampExterior": "s",
      "StatusFunctionsIndicators": "s"
    },
    "de.bmw.infotainment.resetlogic.ResetLogic": {
      "averageConsumption": "rs",
      "bcDataAll": "rs"
    },
    "de.bmw.infotainment.displaydataserver.DisplayDataServer": {
      "functionalLibraryData": "rs",
      "_optional": "the Regal theme's CRUISE lamp"
    },
    "de.bmw.chassis.VehicleStabilizationManagement": {
      "StandStillFunction": "s",
      "_optional": "Auto Hold for the Regal theme's left lamp"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "menu",
      "title": "Custom Cluster",
      "settings": true,
      "items": [
        [
          "text",
          "STATUS",
          "Starting the cluster"
        ],
        [
          "text",
          "DETAIL",
          " "
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "hudLayout",
      "label": "Theme",
      "type": "choice",
      "default": "regal",
      "options": [
        [
          "off",
          "Off (BMW's own cluster)"
        ],
        [
          "regal",
          "Regal (1987)"
        ],
        [
          "sport",
          "Sport"
        ],
        [
          "grid",
          "Calibration grid"
        ]
      ]
    },
    {
      "key": "navLayout",
      "label": "While navigating",
      "type": "choice",
      "default": "sport",
      "options": [
        [
          "sport",
          "Sport, with the map"
        ],
        [
          "regal",
          "Regal (1987)"
        ],
        [
          "off",
          "Off (BMW's own cluster)"
        ],
        [
          "same",
          "No change (the theme above)"
        ]
      ]
    },
    {
      "key": "mapWindow",
      "label": "Leave room for the map (always on while navigating)",
      "type": "bool",
      "default": false
    },
    {
      "key": "units",
      "label": "Units",
      "type": "choice",
      "default": "us",
      "options": [
        [
          "us",
          "mph, °F, psi"
        ],
        [
          "metric",
          "km/h, °C, bar"
        ]
      ]
    },
    {
      "key": "clock",
      "label": "Clock",
      "type": "choice",
      "default": "12h",
      "options": [
        [
          "12h",
          "12-hour"
        ],
        [
          "24h",
          "24-hour"
        ]
      ]
    },
    {
      "key": "redline",
      "label": "Redline (shift light)",
      "type": "number",
      "unit": "rpm",
      "default": 7000,
      "steps": [
        5500,
        6000,
        6500,
        7000,
        7500
      ]
    },
    {
      "key": "shiftBefore",
      "label": "Shift point before redline",
      "type": "number",
      "unit": "rpm",
      "default": 300,
      "steps": [
        0,
        100,
        200,
        300,
        500,
        800,
        1000
      ]
    },
    {
      "key": "coldGuard",
      "label": "Cold-engine rev guard",
      "type": "bool",
      "default": true
    },
    {
      "key": "showBoost",
      "label": "Show boost",
      "type": "bool",
      "default": true
    },
    {
      "key": "mikuSit",
      "label": "Miku sitting on the dash (Regal)",
      "type": "bool",
      "default": true
    },
    {
      "key": "demo",
      "label": "Demo data",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "Auto (until the car sends data)"
        ],
        [
          "on",
          "On"
        ],
        [
          "off",
          "Off"
        ]
      ]
    }
  ],
  "config": {
    "target": "panel",
    "statusName": "Cluster",
    "socketPath": "/dev/shm/cluster-render/render.sock",
    "location": {
      "lat": 35.2271,
      "lon": -80.8431
    },
    "utcOffsetMinutes": null,
    "_comment": "target panel: the whole 1920x720 instrument cluster, drawn over BMW's gauges. socketPath: cluster-render's documented default. location and utcOffsetMinutes: as in Custom HUD (the clock box). tankLitres: the fuel gauge's full mark (the car sends litres, not the tank size; a 2020 G20 M340i holds 59 L / 15.6 gal). engine: the peak crank torque (Nm) and power (kW) the {{torquePct}} and {{powerPct}} tokens count from (an M40i: 500 Nm, 285 kW / 382 hp). lamps: the Regal theme's lamps (the brake lights, BMW's ACC display).",
    "dme": {
      "comment": "Boost from the engine unit (DME, ecu 18) over read-only UDS 0x22, only while the sport display sends no boost and a boost readout is shown. Absolute kPa, the outside air pressure (baro) is subtracted. Candidates tried in order, the first plausible one wins. From cauliflowermossgrape's car_vitals (MIT).",
      "ecu": 18,
      "boost": [
        {
          "did": "F470",
          "bytes": 2,
          "at": 3,
          "factor": 0.03125,
          "offset": 0,
          "min": 20,
          "max": 600,
          "note": "OBD PID 0x70 boost pressure control: actual boost pressure sensor A (absolute), 1/32 kPa"
        },
        {
          "did": "F487",
          "bytes": 2,
          "at": 1,
          "factor": 0.03125,
          "offset": 0,
          "min": 20,
          "max": 600,
          "note": "OBD PID 0x87 intake manifold absolute pressure sensor A, 1/32 kPa"
        },
        {
          "did": "F40B",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": 0,
          "min": 20,
          "max": 255,
          "note": "OBD PID 0x0B intake manifold absolute pressure, kPa (max 255 = 1.5 bar boost)"
        },
        {
          "obd": "0B",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": 0,
          "min": 20,
          "max": 255,
          "note": "OBD service 01 PID 0x0B (same as F40B)"
        }
      ],
      "baro": [
        {
          "did": "F433",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": 0,
          "min": 50,
          "max": 115,
          "note": "OBD PID 0x33 barometric pressure, kPa (101.3 when not available)"
        },
        {
          "obd": "33",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": 0,
          "min": 50,
          "max": 115,
          "note": "OBD service 01 PID 0x33 (same as F433)"
        }
      ],
      "volt": [
        {
          "did": "F442",
          "bytes": 2,
          "at": 0,
          "factor": 0.001,
          "offset": 0,
          "min": 6,
          "max": 18,
          "note": "OBD PID 0x42 control module voltage (the 12 V system), 1/1000 V"
        },
        {
          "obd": "42",
          "bytes": 2,
          "at": 0,
          "factor": 0.001,
          "offset": 0,
          "min": 6,
          "max": 18,
          "note": "OBD service 01 PID 0x42 (same as F442)"
        }
      ],
      "pedal": [
        {
          "did": "F449",
          "bytes": 1,
          "at": 0,
          "factor": 0.392157,
          "offset": 0,
          "min": 0,
          "max": 100,
          "note": "OBD PID 0x49 accelerator pedal position D, A * 100 / 255 %"
        },
        {
          "obd": "49",
          "bytes": 1,
          "at": 0,
          "factor": 0.392157,
          "offset": 0,
          "min": 0,
          "max": 100,
          "note": "OBD service 01 PID 0x49 (same as F449)"
        },
        {
          "did": "F44A",
          "bytes": 1,
          "at": 0,
          "factor": 0.392157,
          "offset": 0,
          "min": 0,
          "max": 100,
          "note": "OBD PID 0x4A accelerator pedal position E"
        }
      ]
    },
    "tankLitres": 59,
    "engine": {
      "torqueNm": 500,
      "powerKw": 285
    },
    "carAhead": true,
    "pedals": true,
    "lamps": true,
    "pedal": {
      "comment": "The throttle bar. source obd: OBD PID 0x49 (accelerator pedal position D) from the engine unit, every 250 ms while shown; obdRange [at rest, flat out] in its own % maps to 0..100 (an X3 M40i reads 14.5 at rest, 82 flat out and 91 in kickdown, Nov 7 2026: the app logs 'accelerator pedal (OBD) ... %' on change, set the two from a release and a full press). Without source obd: the AcceleratorPedal message's actualValueAngleAcceleratorPedal * factor + offset, which on an X3 jumped about (misdecoded). kickdown: the OBD reading at or past which the bar's last segment turns red (between flat out, 82, and kickdown, 91).",
      "source": "obd",
      "obdRange": [
        14.5,
        82
      ],
      "factor": 0.025,
      "offset": 0,
      "kickdown": 87
    },
    "battery": {
      "comment": "The 12 V battery's charge: conditionBatteryChargingCondition * factor + offset = %. BMW's charge condition is normally 0..100; if the logged '12 V battery charge condition raw' goes past 100, it is half-percent steps: set factor 0.5.",
      "factor": 1,
      "offset": 0
    },
    "acc": {
      "comment": "The car ahead: raw * factor + offset. gap: GapVehicleDrivingAhead's raw value to metres, 0.1 m steps (the 1:1 reading was 10 times BMW's own on the car); rel: DataFrontVehicle's speed to km/h when the car sends it; set: cruiseCtrlSpeedHUD.",
      "gap": {
        "factor": 0.1,
        "offset": 0
      },
      "rel": {
        "factor": 1,
        "offset": 0
      },
      "set": {
        "factor": 1,
        "offset": 0
      }
    },
    "consumption": {
      "comment": "Average consumption for the period picked on the center screen (ResetLogic). averageConsumption carries its own decimals (scale / 10^digit) and is used when sent; else bcDataAll's raw consumptionAverage * factor + offset (0.1 is a guess until checked against the stock display: the raw values are logged).",
      "factor": 0.1,
      "offset": 0
    }
  }
}
