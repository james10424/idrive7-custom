{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "mguHmi": ["ID7"],
    "build": {
      "python": "kit/tools/build.py",
      "args": ["{id}"],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}.tgz"
    }
  },
  "components": [
    { "id": "live2d-render", "kind": "tool", "path": "native/live2d-render" }
  ]
}
